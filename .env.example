# Resend (https://resend.com). Without RESEND_API_KEY the quote form runs in mock mode
# and only logs the request on the server.
RESEND_API_KEY=
# Inbox that receives the quote requests.
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "frudev technologies <hola@tudominio.com>".
# Defaults to Resend's onboarding sender, which can only deliver to your own account email.
CONTACT_FROM_EMAIL=
# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
